# Reference only: add missing entries without overwriting your existing .env.
DEPLOYMENT_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
IDENTITY_HASH_KEY=replace-with-a-separate-stable-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:8000
CSRF_TRUSTED_ORIGINS=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ALLOWED_REDIRECT_URIS=
KAKAO_ADMIN_KEY=
LINER_API_KEY=
FRONTEND_SHARE_BASE_URL=
CASE_STORAGE_BACKEND=local
CASE_IMAGE_MAX_BYTES=5242880
CASE_IMAGES_MAX_TOTAL_BYTES=20971520
CASE_IMAGE_MAX_PIXELS=20000000
CASE_IMAGE_RETENTION_DAYS=0
VERDICT_ABANDON_DAYS=30
VERDICT_TIMEOUT_SECONDS=600
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
TRUST_PROXY_HTTPS_HEADER=False
PADDLE_WEBHOOK_SECRET=
# Sandbox API key for catalog setup commands only.
PADDLE_API_KEY=

# AWS production: replace after infrastructure/domains exist.
# DEPLOYMENT_ENV=production
# DATABASE_URL=postgres://user:password@rds-host:5432/dalpan
# CASE_STORAGE_BACKEND=s3
# AWS_STORAGE_BUCKET_NAME=your-private-bucket
# AWS_S3_REGION_NAME=ap-northeast-2
# ALLOWED_HOSTS=api.your-domain.example
# CORS_ALLOWED_ORIGINS=https://your-frontend.example
# CSRF_TRUSTED_ORIGINS=https://api.your-domain.example
# FRONTEND_SHARE_BASE_URL=https://your-frontend.example/shared
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# TRUST_PROXY_HTTPS_HEADER=True

# Cloudflare R2 (S3-compatible): use these instead of the AWS storage values above.
# CASE_STORAGE_BACKEND=s3
# AWS_STORAGE_BUCKET_NAME=your-private-r2-bucket
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=your-r2-access-key-id
# AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Shared search pacing across workers using the same database.
LINER_SEARCH_CONCURRENCY=2
LINER_SCHOLAR_INTERVAL_SECONDS=0.6
LINER_WEB_INTERVAL_SECONDS=0.2
